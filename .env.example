# 루트 .env 예시 — 복사해서 .env로. 이 한 파일을 backend·frontend가 공유한다.
# EXPO_PUBLIC_ 접두어가 붙은 값만 앱 번들에 노출된다 (비밀 키에 이 접두어 금지).

# ── backend ──────────────────────────────────────────────

NODE_ENV=development
PORT=4000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_NAME=app

# 콤마로 복수 origin 허용. app://- 는 데스크톱(Electron) 앱의 내부 오리진 —
# 빼면 데스크톱 앱의 모든 API 호출(로그인 포함)이 CORS로 차단된다. 배포 백엔드에도 포함할 것.
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,app://-

# 메일 속 인증·재설정 링크가 가리킬 주소
APP_BASE_URL=http://localhost:4000

# 소셜 코드 플로우(카카오·네이버)의 redirect_uri를 구성할 백엔드 공개 주소.
# provider 콜백은 ${API_PUBLIC_URL}/api/auth/social/<provider>/callback 로 만들어진다.
# 개발은 compose의 백엔드 포트(4000). 배포 시 https 공개 도메인으로 교체.
API_PUBLIC_URL=http://localhost:4000

# 운영에서 반드시 교체
JWT_SECRET=dev-secret


# 링크 자동구분의 지오코딩(주소→좌표, developers.kakao.com). 비우면 지오코딩만 스킵
KAKAO_REST_API_KEY=

# 카카오 로그인(코드 플로우). CLIENT_ID = 카카오 콘솔 > 앱 > 앱 키의 REST API 키.
# 콘솔 > 카카오 로그인 > Redirect URI 에 아래 콜백을 등록해야 한다(개발 기준):
#   http://localhost:4000/api/auth/social/kakao/callback
# CLIENT_SECRET: 콘솔 > 카카오 로그인 > 보안에서 발급(기본 활성). 비우면 파라미터 생략.
# SCOPE: 콘솔 > 동의항목에서 활성화한 항목과 맞출 것(기본 profile_nickname,account_email).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_SCOPE=profile_nickname,account_email

# 네이버 로그인(코드 플로우). CLIENT_ID/SECRET = 네이버 개발자센터 > 애플리케이션 정보.
# 개발자센터 > 애플리케이션 정보 > Callback URL 에 아래 콜백을 등록해야 한다(개발 기준):
#   http://localhost:4000/api/auth/social/naver/callback
# CLIENT_SECRET은 항상 필수(카카오와 달리 생략 불가).
# 주의: 검수(공개 상태 전환) 전에는 개발자센터에 등록한 테스터 ID로만 로그인 가능하다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 메일 — 개발은 mailpit이 가로챔(http://localhost:8025), 배포 시 Resend/SES 값으로 교체
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=slash <no-reply@slash.local>

# 구글 로그인 서버 검증용 클라이언트 ID 허용 목록 (웹/iOS/안드로이드/데스크톱, 콤마 허용)
GOOGLE_CLIENT_IDS=

# 애플 로그인 서버 검증용 클라이언트(번들) ID 허용 목록 (콤마 허용)
# iOS 번들 ID(com.app.slash), Expo Go 테스트 시 host.exp.Exponent 추가
APPLE_CLIENT_IDS=

# ── desktop (Electron 구글 로그인) ───────────────────────
# 구글 데스크톱 클라이언트 ID
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=

# ── frontend (EXPO_PUBLIC_*) ─────────────────────────────

# 구글 로그인 클라이언트 ID (웹 / iOS 빌드 / 안드로이드 빌드)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# 카카오 로그인 버튼 노출 플래그(truthy면 웹·네이티브에 노출, Electron은 항상 숨김).
# 백엔드 KAKAO_CLIENT_ID까지 세팅됐을 때만 1로 켤 것.
EXPO_PUBLIC_SOCIAL_KAKAO=

# 네이버 로그인 버튼 노출 플래그(truthy면 웹·네이티브에 노출, Electron은 항상 숨김).
# 백엔드 NAVER_CLIENT_ID까지 세팅됐을 때만 1로 켤 것.
EXPO_PUBLIC_SOCIAL_NAVER=

# 배포 빌드가 바라볼 백엔드 주소 (예: https://api.example.com).
# 비우면 개발 폴백(Expo 개발 서버 IP / localhost:4000)을 쓴다.
EXPO_PUBLIC_API_URL=

# 링크 카드의 흑백 미니지도 (Google Static Maps API 키). 비우면 og 이미지로 폴백
EXPO_PUBLIC_GMAPS_STATIC_KEY=
