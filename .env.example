# 루트 .env 예시 — 복사해서 .env로 만들고 값을 채우세요.
NODE_ENV=development
PORT=4000

# 콤마로 여러 origin 허용 가능
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_NAME=app

# JWT 서명 키 (운영에서는 반드시 바꿀 것)
JWT_SECRET=dev-secret

# 백엔드 검증용 구글 OAuth 클라이언트 ID (콤마로 여러 개 허용: 웹/iOS/안드로이드)
GOOGLE_CLIENT_IDS=

# 프론트(Expo)용 구글 웹 클라이언트 ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS 네이티브용 (development build / 배포 빌드에서 사용)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android 네이티브용 (development build / 배포 빌드에서 사용)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# 메일 발송 (개발: mailpit / 배포: Resend·SES 등으로 교체)
# 컨테이너 네트워크에서는 host가 mailpit, 로컬 직접 실행 시엔 localhost.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=slash <no-reply@slash.local>

# 인증/비번재설정 링크가 가리킬 백엔드 주소 (브라우저에서 열리는 주소)
APP_BASE_URL=http://localhost:4000
