# 루트 .env 예시 — 복사해서 .env로 만들고 값을 채우세요.
NODE_ENV=development
PORT=4000

# 콤마로 여러 origin 허용 가능
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_NAME=app

# JWT 서명 키 (운영에서는 반드시 바꿀 것)
JWT_SECRET=dev-secret
