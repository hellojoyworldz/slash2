# 루트 .env 예시 — 복사해서 .env로. 이 한 파일을 backend·frontend가 공유한다.
# EXPO_PUBLIC_ 접두어가 붙은 값만 앱 번들에 노출된다 (비밀 키에 이 접두어 금지).

# ── backend ──────────────────────────────────────────────

NODE_ENV=development
PORT=4000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_NAME=app

# 콤마로 복수 origin 허용
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# 메일 속 인증·재설정 링크가 가리킬 주소
APP_BASE_URL=http://localhost:4000

# 운영에서 반드시 교체
JWT_SECRET=dev-secret

# 구글 로그인 서버 검증용 클라이언트 ID (웹/iOS/안드로이드, 콤마 허용)
GOOGLE_CLIENT_IDS=

# 링크 자동구분의 지오코딩(주소→좌표, developers.kakao.com). 비우면 지오코딩만 스킵
KAKAO_REST_API_KEY=

# 메일 — 개발은 mailpit이 가로챔(http://localhost:8025), 배포 시 Resend/SES 값으로 교체
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=slash <no-reply@slash.local>

# ── frontend (EXPO_PUBLIC_*) ─────────────────────────────

# 구글 로그인 클라이언트 ID (웹 / iOS 빌드 / 안드로이드 빌드)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# 링크 카드의 흑백 미니지도 (Google Static Maps API 키). 비우면 og 이미지로 폴백
EXPO_PUBLIC_GMAPS_STATIC_KEY=
